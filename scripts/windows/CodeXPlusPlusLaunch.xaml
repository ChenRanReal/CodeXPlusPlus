<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CodeX++" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryText" Color="#F0F3FA"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#A6B2C8"/>
    <SolidColorBrush x:Key="Accent" Color="#75EACB"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
      <Setter Property="Background" Value="#202A3D"/>
      <Setter Property="BorderBrush" Value="#394660"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonFrame" CornerRadius="7"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#75EACB"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonFrame" Property="Opacity" Value=".72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonFrame" Property="Opacity" Value=".45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RowMark" TargetType="TextBlock">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Text" Value="○"/>
      <Setter Property="Foreground" Value="#7C8AA4"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="RowText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PrimaryText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Border x:Name="LaunchCard" BorderBrush="#3A4862" BorderThickness="1" CornerRadius="17"
          UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1C2840" Offset="0"/>
        <GradientStop Color="#141D30" Offset=".5"/>
        <GradientStop Color="#11192A" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="27,21,27,23">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="Header" Margin="0,0,0,25" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="BrandImage" Width="45" Height="45" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,2"
                   FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}">
          <Run Text="CodeX"/><Run Text="++" Foreground="{StaticResource Accent}"/>
        </TextBlock>
        <Button x:Name="CloseButton" Grid.Column="2" Width="32" Height="32" Padding="0"
                VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent"
                Content="×" FontSize="20" ToolTip="关闭" AutomationProperties.Name="关闭启动窗口"/>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,0,0,20">
        <TextBlock x:Name="StateTitle" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryText}" Text="正在检查启动环境"/>
        <TextBlock x:Name="StateDetail" Foreground="{StaticResource SecondaryText}" Margin="0,7,0,0"
                   TextWrapping="Wrap" MinHeight="20" Text="确认本机文件与 Codex Desktop。"/>
      </StackPanel>
      <Border Grid.Row="2" Background="#A5101726" BorderBrush="#33415B" BorderThickness="1" CornerRadius="11"
              Padding="14,8" Margin="0,0,0,16">
        <StackPanel>
          <DockPanel Height="32">
            <TextBlock x:Name="CheckMark" Style="{StaticResource RowMark}" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource RowText}" Text="检查启动环境"/>
          </DockPanel>
          <Border Background="#27344B" Height="1" />
          <DockPanel Height="32">
            <TextBlock x:Name="DesktopMark" Style="{StaticResource RowMark}" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource RowText}" Text="启动 Codex Desktop"/>
          </DockPanel>
          <Border Background="#27344B" Height="1" />
          <DockPanel Height="32">
            <TextBlock x:Name="RendererMark" Style="{StaticResource RowMark}" VerticalAlignment="Center"/>
            <TextBlock Style="{StaticResource RowText}" Text="接上 Host 并加载扩展"/>
          </DockPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="3" Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="LaunchProgress" VerticalAlignment="Center" Height="4"
                     Background="#26344A" Foreground="{StaticResource Accent}"
                     Margin="0,0,12,0" BorderThickness="0" IsIndeterminate="True"/>
        <TextBlock x:Name="ElapsedText" Grid.Column="1" VerticalAlignment="Center"
                   Foreground="{StaticResource SecondaryText}" Text="已等待 00:00"/>
      </Grid>
      <DockPanel Grid.Row="4" Margin="0,0,0,2">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal" x:Name="Actions" Visibility="Collapsed" Margin="0,0,0,8">
            <Button x:Name="RestartButton" Content="重新启动" Margin="0,0,8,0" Visibility="Collapsed"
                    Background="#75EACB" Foreground="#12251F" BorderBrush="#75EACB" FontWeight="SemiBold"/>
            <Button x:Name="DismissButton" Content="取消" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="RetryButton" Content="重试" Background="#75EACB"
                    Foreground="#12251F" BorderBrush="#75EACB" FontWeight="SemiBold"/>
          </StackPanel>
          <Expander x:Name="Details" Header="错误详情" Foreground="{StaticResource SecondaryText}"
                    Visibility="Collapsed">
            <Border Background="#11192A" CornerRadius="7" Padding="9" Margin="0,7,0,8">
              <TextBlock x:Name="DiagnosticText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
            </Border>
          </Expander>
          <Button x:Name="CopyButton" HorizontalAlignment="Left" Content="复制当前状态" Padding="0,4"
                  Background="Transparent" BorderBrush="Transparent"/>
        </StackPanel>
        <Border Background="#11192A" BorderBrush="#33415B" BorderThickness="1" CornerRadius="9" Padding="10,8">
          <ScrollViewer x:Name="ActivityScroll" MaxHeight="108" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ActivityLog" Foreground="{StaticResource SecondaryText}" FontSize="12"
                       FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"
                       Text="00:00  正在确认本机文件与 Codex Desktop"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </Border>
</Window>
